            }

        # Inbound Heuristic B: Command Outputs / Diagnostics Requested from Server (e.g. Ticket 43)
        if any(k in latest_text for k in ["rpm -qa", "swversion", "av-version", "sysinfo", "pcap", "packet capture", "trace", "syslog", "debug", "collect log", "send us", "provide log", "provide the output"]):
            cmd_list = "rpm -qa, swversion, av-version, sysInfo" if ("rpm" in latest_text or "swversion" in latest_text) else "diagnostic logs / traces"
