                },
                "source": "Hybrid AI (Instant Rule Engine)"
            }

        # Inbound Heuristic D: Open Notification / New Service Request Confirmation
        if any(k in latest_text for k in ["open notification", "we just received your service request", "sr opened", "successfully created", "service request alert"]):
            prod_name = ticket.avaya_product or "Avaya System"
            return {
