        # Inbound Heuristic C: Top 100 CVEs / Vendor SME Internal Review (e.g. Ticket 41)
        if any(k in latest_text for k in ["top 100", "review the attached spreadsheet", "vulnerabilities", "jay", "borra"]):
            return {
