<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define the module category for grouping -->
    <record id="module_category_helpdesk_ticket_pro" model="ir.module.category">
        <field name="name">Helpdesk Pro (Ticketing)</field>
        <field name="description">Access levels for Odoo Helpdesk Pro</field>
        <field name="sequence">20</field>
    </record>

    <!-- Group 1: User (Read-Only) -->
    <record id="group_helpdesk_ticket_pro_user" model="res.groups">
        <field name="name">User (Read-Only)</field>
        <field name="category_id" ref="module_category_helpdesk_ticket_pro"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Group 2: Engineer -->
    <record id="group_helpdesk_ticket_pro_engineer" model="res.groups">
        <field name="name">Engineer</field>
        <field name="category_id" ref="module_category_helpdesk_ticket_pro"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_ticket_pro_user'))]"/>
    </record>

    <!-- Group 3: Admin -->
    <record id="group_helpdesk_ticket_pro_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_helpdesk_ticket_pro"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_ticket_pro_engineer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
