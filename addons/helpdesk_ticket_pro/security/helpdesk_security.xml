<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Portal User Record Rule: Can only see their own tickets -->
        <record id="helpdesk_ticket_pro_portal_rule" model="ir.rule">
            <field name="name">Portal Personal Tickets Only</field>
            <field name="model_id" ref="model_helpdesk_ticket_pro"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
